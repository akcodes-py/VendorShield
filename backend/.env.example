# WHY: secrets never in code. Copy to .env locally. Never commit .env.
# Dev/demo DB = local PostgreSQL. Tests override with SQLite memory.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vendorshield
TEST_DATABASE_URL=sqlite:///:memory:

# JWT - WHY: short access + longer refresh limits damage if stolen.
JWT_SECRET=change-me-to-32-random-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Uploads - WHY: size limit blocks disk-fill DoS.
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=10

# Optional AI - WHY: off by default so no vendor data leaks accidentally.
GEMINI_API_KEY=
AI_SUMMARY_ENABLED=false
